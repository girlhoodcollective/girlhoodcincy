---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    n: '01', id: 'consultation', title: 'Strategic Consultation', tag: 'Think · plan · decide',
    body: "A clear-eyed outside voice for the problem underneath the problem. We start with what's actually happening — not the board-meeting version — and find where a small, honest change moves everything downstream.",
    points: [
      'For founders, EDs, and leaders navigating something they can’t quite name',
      'You leave with a diagnosis, a first step, and language for the room',
    ],
  },
  {
    n: '02', id: 'hr', title: 'HR & People Strategy', tag: 'Culture · hiring · access',
    body: 'Culture and environments designed for how people actually work — including neurodivergent access. Belonging isn’t a training; it’s how the room is built. I help you build it, from hiring practices to the way meetings run.',
    points: [
      'For teams losing good people quietly, or growing without a culture on purpose',
      'Environment audits, listening processes, and practical redesign — not policy theater',
    ],
  },
  {
    n: '03', id: 'program', title: 'Program Design', tag: 'Build · rethink · reach',
    body: "Build or rethink what you offer — starting with the community you're trying to reach, not the program itself. Before we build anything, we learn who isn't showing up, why, and what they actually need. That work shapes everything downstream.",
    points: [
      "For nonprofits, schools, and civic orgs whose programming isn't landing",
      'Grounded in real community input, tested in real rooms',
    ],
  },
];

const steps = [
  { n: '1', title: 'Start with the intake', body: 'An 8-minute diagnostic tells me what you’re really carrying — before we ever talk.', accent: 'var(--gc-emerald)' },
  { n: '2', title: 'A real conversation', body: 'No pitch, no pressure. An honest look at whether I’m the right person for this.', accent: 'var(--gc-lavender)' },
  { n: '3', title: 'Scoped to the situation', body: 'Every engagement is built for the actual problem — not a menu of packages.', accent: 'var(--gc-pink)' },
];
---

<Layout title="Work With Me">
  <Nav variant="white" active="Work With Me" />

  <div class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <div class="rule" style="margin-bottom:24px"></div>
      <div class="eyebrow eyebrow-sky" style="margin-bottom:18px">Consulting · Facilitation · People strategy</div>
      <h1 class="serif-heading hero-heading" style="color:#fff">Build a room where people are <span class="serif-script" style="color:var(--gc-lavender-soft)">understood.</span></h1>
      <p class="hero-copy">I help organizations and the women inside them build environments where people are actually seen — combining people strategy, program design, and lived experience of navigating rooms that weren't built for how everyone works.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/consultation-intake">Start the intake →</a>
        <a class="btn btn-outline-light" href="#book">Book a call</a>
      </div>
    </div>
  </div>

  <div class="svc-nav">
    <a class="navlink" href="#consultation">Strategic Consultation</a>
    <a class="navlink" href="#hr">HR &amp; People Strategy</a>
    <a class="navlink" href="#program">Program Design</a>
    <a class="navlink" href="#ugc">UGC &amp; Creator</a>
  </div>

  <div class="services">
    <div class="services-inner">
      {services.map((s, i) => (
        <div class="svc" id={s.id} style={i === services.length - 1 ? 'border-bottom:none;padding-bottom:8px' : ''}>
          <div>
            <div class="display-heading" style="font-size:34px;color:var(--gc-lavender-soft);margin-bottom:8px">{s.n}</div>
            <div class="serif-heading" style="font-size:24px;line-height:1.2">{s.title}</div>
            <div style="font:600 10px var(--font-sans);letter-spacing:.16em;text-transform:uppercase;color:var(--gc-emerald);margin-top:10px">{s.tag}</div>
          </div>
          <div>
            <p class="svc-copy">{s.body}</p>
            <div class="svc-points">
              {s.points.map((p) => (
                <div class="svc-point"><span style="color:var(--gc-emerald);font-weight:600">✦</span>&nbsp; {p}</div>
              ))}
            </div>
          </div>
        </div>
      ))}
      <div class="svc" id="ugc" style="border-bottom:none;padding-top:44px">
        <div>
          <div class="display-heading" style="font-size:34px;color:var(--gc-lavender-soft);margin-bottom:8px">04</div>
          <div class="serif-heading" style="font-size:24px;line-height:1.2">UGC &amp; Creator Partnerships</div>
          <div style="font:600 10px var(--font-sans);letter-spacing:.16em;text-transform:uppercase;color:var(--gc-emerald);margin-top:10px">Felt · not sold</div>
        </div>
        <div>
          <p class="svc-copy">Authentic, community-rooted content for brands who want to be felt before they're sold. Real voice, real audience, real trust — the kind of creator work that reads like a neighbor's recommendation, not an ad.</p>
          <a class="navlink" href="/ugc" style="color:var(--gc-emerald)">See the portfolio &amp; rate card →</a>
        </div>
      </div>
    </div>
  </div>

  <div class="how">
    <div class="how-head">
      <div class="eyebrow eyebrow-emerald" style="font-weight:700;margin-bottom:12px">How it works</div>
      <div class="serif-heading" style="font-size:28px">No packages. Just the <span class="serif-script" style="color:var(--gc-emerald)">right</span> fit.</div>
    </div>
    <div class="steps-grid">
      {steps.map((s) => (
        <div class="stat-card" style={`border-top-color:${s.accent}`}>
          <div class="card-num">{s.n}</div>
          <div class="serif-heading" style="font-size:17px;margin-bottom:6px">{s.title}</div>
          <p style="font-size:13px;font-weight:300;color:var(--gc-ink-muted);line-height:1.65">{s.body}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="lens">
    <div class="lens-inner">
      <div class="eyebrow" style="font-weight:700;margin-bottom:18px;color:#F6C6DD">The lens I bring</div>
      <div class="serif-heading" style="font-size:26px;line-height:1.4;color:#fff">I don't theorize about rooms that weren't built for you. As a later-in-life AuDHD diagnosis and a Black woman in predominantly white civic spaces, <span style="color:var(--gc-lavender-soft)">I've navigated them from the inside.</span></div>
      <p class="lens-copy">That's pattern recognition, not just frameworks. It shapes how I listen, how I facilitate, and what I notice before anyone says a word — and it's why the work usually isn't about fixing the person. It's about fixing the room they were given.</p>
      <div class="serif-script" style="font-size:22px;color:var(--gc-lavender-soft);margin-top:22px">— Brittany</div>
    </div>
  </div>

  <div id="book" class="book-cta">
    <div class="serif-heading" style="font-size:28px;margin-bottom:8px">Let's get to <span class="serif-script" style="color:var(--gc-emerald)">work.</span></div>
    <p class="book-copy">The best first step is the intake — it makes our conversation ten times more useful. Or reach out directly and we'll find a time.</p>
    <div class="book-actions">
      <a class="btn btn-primary" href="/consultation-intake">Start the intake</a>
      <a class="btn btn-outline" href="mailto:hello@girlhoodcincy.com">Email hello@girlhoodcincy.com</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .hero { background: var(--gc-navy); padding: 64px 44px 58px; position: relative; overflow: hidden; }
  .hero-glow { position: absolute; top: -90px; right: -70px; width: 340px; height: 340px; border-radius: 50%; background: radial-gradient(circle, rgba(186, 217, 243, .22), transparent 70%); }
  .hero-inner { position: relative; z-index: 2; max-width: 720px; }
  .hero-heading { font-size: 50px; line-height: 1.08; }
  .hero-copy { font-size: 16px; font-weight: 300; color: rgba(255, 255, 255, .74); line-height: 1.85; max-width: 560px; margin: 22px 0 28px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  .svc-nav { background: var(--gc-section); border-bottom: 1px solid var(--gc-border); padding: 16px 44px; display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; position: sticky; top: 57px; z-index: 90; }
  .svc-nav .navlink { color: var(--gc-ink-muted); }
  .svc-nav .navlink:hover { color: var(--gc-emerald); }

  .services { background: #fff; padding: 60px 44px; }
  .services-inner { max-width: 900px; margin: 0 auto; }
  .svc { scroll-margin-top: 80px; display: grid; grid-template-columns: 220px 1fr; gap: 36px; padding: 44px 0; border-bottom: 1px solid var(--gc-border); }
  .svc:first-child { padding-top: 0; }
  .svc-copy { font-size: 15px; font-weight: 300; color: var(--gc-ink); line-height: 1.85; margin-bottom: 16px; }
  .svc-points { display: flex; flex-direction: column; gap: 8px; }
  .svc-point { font-size: 14px; color: var(--gc-ink-muted); line-height: 1.6; }

  .how { background: var(--gc-section); padding: 58px 44px; border-top: 1px solid var(--gc-border); }
  .how-head { text-align: center; margin-bottom: 34px; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 900px; margin: 0 auto; }

  .lens { background: var(--gc-slate); padding: 58px 44px; }
  .lens-inner { max-width: 760px; margin: 0 auto; }
  .lens-copy { font-size: 15px; font-weight: 300; color: rgba(255, 255, 255, .72); line-height: 1.85; margin-top: 20px; }

  .book-cta { background: var(--gc-sage-light); border-top: 1px solid #dde6e2; padding: 56px 44px; text-align: center; }
  .book-copy { font-size: 14.5px; font-weight: 300; color: var(--gc-ink-muted); line-height: 1.75; max-width: 480px; margin: 0 auto 24px; }
  .book-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .svc { grid-template-columns: 1fr; }
    .steps-grid { grid-template-columns: 1fr; }
  }
</style>
