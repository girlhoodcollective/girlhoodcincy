---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NumberedCard from '../components/NumberedCard.astro';

const navyLinks = [
  { label: 'Events & Workshops', href: '/events' },
  { label: 'About', href: '/about' },
  { label: 'Partners', href: '/partners' },
];

const values = [
  { n: '01', title: 'Real Connection', body: 'Rooms where people actually meet — not networks, neighbors.', accent: 'var(--gc-emerald)' },
  { n: '02', title: 'Community First', body: 'Community comes before the algorithm. Always.', accent: 'var(--gc-lavender)' },
  { n: '03', title: 'Authenticity Over Performance', body: 'Show up as you are. That’s the whole point.', accent: 'var(--gc-emerald)' },
  { n: '04', title: 'Discernment as a Skill', body: 'We choose carefully so you don’t have to. Curation is care.', accent: 'var(--gc-slate)' },
  { n: '05', title: 'Space to Breathe', body: 'No urgency-bait, no noise. Slow, warm, on purpose.', accent: 'var(--gc-emerald)' },
  { n: '06', title: 'Intergenerational Impact', body: 'Women of every age and industry, in the same room.', accent: 'var(--gc-lavender)' },
];

const stats = [
  { value: '2025', label: 'Founded' },
  { value: '12+', label: 'Events hosted' },
  { value: '4', label: 'Community partners' },
  { value: '66%', label: 'Newsletter open rate' },
];
---

<Layout title="About">
  <Nav variant="navy" active="About" links={navyLinks} />

  <div class="hero">
    <div class="rule"></div>
    <div class="eyebrow eyebrow-sky" style="margin-bottom:16px">Our story</div>
    <h1 class="display-heading hero-heading">Uniting makers, teachers, leaders &amp; learners <span class="serif-script" style="color:var(--gc-lavender-soft)">since 2025.</span></h1>
    <p class="hero-copy">We connect women and girls to the people, programs, and experiences that they've been missing — right here on Cincinnati's Greater Cincinnati.</p>
  </div>

  <div class="founder">
    <div class="founder-photo">A photo of Brittany</div>
    <div>
      <div class="eyebrow eyebrow-emerald" style="font-weight:700;margin-bottom:12px">Meet the founder</div>
      <div class="serif-heading" style="font-size:30px;margin-bottom:8px">Brittany Gruber</div>
      <div style="font:600 12px var(--font-sans);color:var(--gc-ink-muted);margin-bottom:20px">Founder · Girlhood Collective</div>
      <p class="founder-copy">Girlhood Collective started the way most good things do — with a room, some folding chairs, and the stubborn belief that women and girls deserve spaces built on connection instead of performance. Because community shouldn't feel manufactured — we all deserve to find our village.</p>
      <p class="founder-copy" style="margin-bottom:22px">What began as a single workshop has grown into a community hub of events, workshops, florals, and neighbors — makers, teachers, leaders, and learners, all in the same room. Connecting the dots, it turns out, is the whole job.</p>
      <div class="founder-quote">
        <p class="serif-script" style="font-size:18px;color:var(--gc-slate);margin-bottom:8px">"Connecting the dots is my superpower."</p>
        <div class="serif-script" style="font-size:22px;color:var(--gc-lavender)">— BG</div>
      </div>
    </div>
  </div>

  <div class="personal">
    <div class="personal-inner">
      <div class="eyebrow" style="font-weight:700;margin-bottom:20px;color:var(--gc-pink-pale)">Why this is personal</div>
      <div class="serif-heading" style="font-size:30px;line-height:1.28;letter-spacing:-.01em;color:#fff">Diagnosed with ADHD and autism later in life, I know what it's like to navigate a world that wasn't built for the way your brain works best.</div>
      <p class="personal-copy">That journey fuels the work. I love helping others understand themselves, embrace their strengths, and advocate for what they need — and helping organizations learn what it really means to be genuinely inclusive.</p>
      <div class="serif-script" style="font-size:24px;color:var(--gc-lavender-soft);margin-top:24px">— Brittany</div>
    </div>
  </div>

  <div class="manifesto">
    <div class="manifesto-head">
      <div class="eyebrow eyebrow-emerald" style="font-weight:700;margin-bottom:12px">What we believe</div>
      <div class="serif-heading" style="font-size:30px">We believe in <span class="serif-script" style="color:var(--gc-lavender)">doing it differently.</span></div>
    </div>
    <div class="values-grid">
      {values.map((v) => (
        <NumberedCard number={v.n} title={v.title} body={v.body} accent={v.accent} />
      ))}
    </div>
  </div>

  <div class="stats">
    {stats.map((s, i) => (
      <div class={`stat${i < stats.length - 1 ? ' stat--divided' : ''}`}>
        <div class="display-heading" style="font-size:44px;color:var(--gc-emerald);line-height:1">{s.value}</div>
        <div style="font:600 10px var(--font-sans);letter-spacing:.16em;text-transform:uppercase;color:var(--gc-ink-muted);margin-top:6px">{s.label}</div>
      </div>
    ))}
  </div>

  <div class="cta">
    <div class="serif-heading" style="font-size:26px;margin-bottom:8px">Want to build something <span class="serif-script" style="color:var(--gc-emerald)">together?</span></div>
    <p class="cta-copy">Collaborations, partnerships, and good ideas are always welcome. Reach out directly.</p>
    <div class="cta-actions">
      <a class="btn btn-primary" href="/partners">Become a partner</a>
      <a class="btn btn-outline" href="/newsletter">Join the newsletter</a>
    </div>
  </div>

  <Footer showExplore={false} />
</Layout>

<style>
  /* Page secondary accent: Sage — soft, calming, community/values (Brand Identity Guide) */
  :global(.page) {
    --gc-emerald: var(--gc-sage);
    --gc-emerald-soft: var(--gc-sage);
    --gc-sage-light: var(--gc-sage-wash);
  }

  .hero { background: var(--gc-slate); padding: 56px 44px 52px; }
  .hero-heading { font-size: 52px; color: #fff; line-height: 1.04; max-width: 720px; margin: 0; }
  .hero-copy { font-size: 15px; font-weight: 300; color: rgba(255, 255, 255, .72); line-height: 1.85; max-width: 560px; margin-top: 20px; }

  .founder { background: #fff; padding: 64px 44px; display: grid; grid-template-columns: 340px 1fr; gap: 44px; align-items: center; max-width: 960px; margin: 0 auto; }
  .founder-photo {
    width: 340px; height: 400px; display: flex; align-items: center; justify-content: center; text-align: center;
    background: var(--gc-section); border-radius: 8px; color: var(--gc-ink-muted); font-size: 13px;
  }
  .founder-copy { font-size: 15px; font-weight: 300; color: var(--gc-ink); line-height: 1.85; margin-bottom: 14px; }
  .founder-quote { border-left: 3px solid var(--gc-emerald); padding-left: 18px; }

  .personal { background: var(--gc-slate); padding: 60px 44px; }
  .personal-inner { max-width: 820px; margin: 0 auto; }
  .personal-copy { font-size: 15px; font-weight: 300; color: rgba(255, 255, 255, .72); line-height: 1.85; max-width: 680px; margin-top: 24px; }

  .manifesto { background: var(--gc-section); padding: 60px 44px; }
  .manifesto-head { text-align: center; margin-bottom: 36px; }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 940px; margin: 0 auto; }

  .stats { background: #fff; padding: 52px 44px; display: flex; justify-content: center; flex-wrap: wrap; }
  .stat { text-align: center; padding: 0 40px; }
  .stat--divided { border-right: 1px solid var(--gc-border); }

  .cta { background: var(--gc-sage-light); border-top: 1px solid #dde6e2; padding: 52px 44px; text-align: center; }
  .cta-copy { font-size: 14px; font-weight: 300; color: var(--gc-ink-muted); line-height: 1.7; max-width: 460px; margin: 0 auto 22px; }
  .cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .founder { grid-template-columns: 1fr; }
    .founder-photo { width: 100%; }
    .values-grid { grid-template-columns: 1fr; }
    .stat { padding: 12px 24px; }
  }
</style>
