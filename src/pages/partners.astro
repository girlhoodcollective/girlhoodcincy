---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const navyLinks = [
  { label: 'Events & Workshops', href: '/events' },
  { label: 'About', href: '/about' },
  { label: 'Partners', href: '/partners' },
];

const partners = [
  { name: 'Pillar', tag: 'Pelvic Health & PT', accent: 'var(--gc-navy)', body: "Women's pelvic health and physical therapy that meets you with real expertise and even realer talk." },
  { name: 'Trillium', tag: 'Custom Cakes', accent: 'var(--gc-lavender)', body: 'Show-stopping custom cakes for the birthdays, showers, and Saturdays worth gathering around.' },
  { name: 'Endurance in Education', tag: 'Youth Mentorship · Brunch Beneficiary', accent: 'var(--gc-emerald)', body: "Cross-industry mentorship building Cincinnati's next generation of leaders — and the cause behind Better Together." },
];

const why = [
  { icon: '🤝', title: 'Engaged audience', body: 'Reach women of every age and industry through events, markets, and a newsletter with a 52–66% open rate.', accent: 'var(--gc-emerald)' },
  { icon: '💗', title: 'Real community', body: 'Not impressions — relationships. Our partners become part of the neighborhood, not a logo on a banner.', accent: 'var(--gc-lavender)' },
  { icon: '🎓', title: 'Tangible impact', body: 'A portion of event proceeds supports youth mentorship. Your name goes toward something that lasts.', accent: 'var(--gc-navy)' },
];
---

<Layout title="Partners">
  <Nav variant="navy" active="Partners" links={navyLinks} />

  <div class="hero">
    <div class="rule"></div>
    <div class="eyebrow eyebrow-sky" style="margin-bottom:16px">The neighborhood</div>
    <h1 class="display-heading hero-heading">Built <span class="serif-script" style="color:var(--gc-lavender-soft)">alongside</span> good people.</h1>
    <p class="hero-copy">We partner with women-led businesses, educators, makers, and community leaders across Cincinnati. Because we're better together.</p>
  </div>

  <div class="directory">
    <div class="eyebrow eyebrow-emerald" style="font-weight:700;margin-bottom:10px">Our community partners</div>
    <div class="serif-heading" style="font-size:28px;margin-bottom:28px">In good company</div>
    <div class="partners-grid">
      {partners.map((p) => (
        <div class="prtcard" style={`border-top-color:${p.accent}`}>
          <div class="serif-heading" style="font-size:19px;margin-bottom:4px">{p.name}</div>
          <div class="eyebrow" style={`font-size:9px;margin-bottom:12px;color:${p.accent}`}>{p.tag}</div>
          <p style="font-size:13.5px;font-weight:300;color:var(--gc-ink-muted);line-height:1.65">{p.body}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="why">
    <div class="why-head">
      <div class="eyebrow eyebrow-emerald" style="font-weight:700;margin-bottom:12px">Why partner with us</div>
      <div class="serif-heading" style="font-size:28px">A room worth being in</div>
    </div>
    <div class="why-grid">
      {why.map((w) => (
        <div class="stat-card" style={`border-top-color:${w.accent}`}>
          <div style="font-size:24px;margin-bottom:10px">{w.icon}</div>
          <div class="serif-heading" style="font-size:16px;margin-bottom:6px">{w.title}</div>
          <p style="font-size:13px;font-weight:300;color:var(--gc-ink-muted);line-height:1.65">{w.body}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="form-section">
    <div class="form-wrap">
      <div class="form-head">
        <div class="eyebrow eyebrow-emerald" style="font-weight:700;margin-bottom:12px">Let's talk</div>
        <div class="serif-heading" style="font-size:30px">Become a <span class="serif-script" style="color:var(--gc-emerald)">partner</span></div>
        <p class="form-lede">Tell us a little about you and we'll reach out within a day or two. No pitch decks required.</p>
      </div>

      <div id="prt-success" class="prt-success" hidden>
        <div style="font-size:34px;margin-bottom:10px">💌</div>
        <div class="serif-script" style="font-size:30px;color:var(--gc-slate);margin-bottom:8px">Thank you!</div>
        <p style="font-size:14px;font-weight:300;color:var(--gc-ink-muted);line-height:1.7;max-width:400px;margin:0 auto 4px">We got your note and we'll be in touch within a day or two. Connecting the dots is our favorite part.</p>
        <div class="serif-script" style="font-size:20px;color:var(--gc-lavender);margin-top:14px">— BG</div>
      </div>

      <form id="prt-form" class="prt-form">
        <div class="form-grid">
          <input class="field" placeholder="Business / organization" name="org" required />
          <input class="field" placeholder="Your name" name="name" required />
        </div>
        <div class="form-grid" style="margin-top:12px">
          <input class="field" type="email" placeholder="Email address" name="email" required />
          <select class="field" name="interest">
            <option value="">I'm interested in…</option>
            <option value="event">Event sponsorship</option>
            <option value="community">Community partnership</option>
            <option value="maker">Joining as a maker</option>
            <option value="collab">A collaboration</option>
          </select>
        </div>
        <textarea class="field" placeholder="Tell us a little about what you have in mind" name="message" rows="4" style="margin-top:12px;margin-bottom:16px"></textarea>
        <button class="btn btn-primary" type="submit" style="width:100%">Send it our way</button>
      </form>
    </div>
  </div>

  <Footer showExplore={false} />
</Layout>

<script>
  const form = document.getElementById('prt-form') as HTMLFormElement | null;
  const success = document.getElementById('prt-success');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    if (success) success.hidden = false;
  });
</script>

<style>
  /* Page secondary accent: Sage — soft, calming, community/values (Brand Identity Guide) */
  :global(.page) {
    --gc-emerald: var(--gc-sage);
    --gc-emerald-soft: var(--gc-sage);
    --gc-sage-light: var(--gc-sage-wash);
  }

  .hero { background: var(--gc-slate); padding: 56px 44px 52px; }
  .hero-heading { font-size: 52px; color: #fff; line-height: 1.04; max-width: 640px; margin: 0; }
  .hero-copy { font-size: 15px; font-weight: 300; color: rgba(255, 255, 255, .72); line-height: 1.85; max-width: 560px; margin-top: 20px; }

  .directory { background: #fff; padding: 60px 44px; }
  .partners-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .prtcard { border: 1px solid var(--gc-border); border-radius: 4px; border-top: 4px solid; padding: 28px 26px; transition: border-color .2s, transform .2s; }
  .prtcard:hover { transform: translateY(-3px); }

  .why { background: var(--gc-section); padding: 56px 44px; }
  .why-head { text-align: center; margin-bottom: 34px; }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 900px; margin: 0 auto; }

  .form-section { background: #fff; padding: 60px 44px; }
  .form-wrap { max-width: 640px; margin: 0 auto; }
  .form-head { text-align: center; margin-bottom: 28px; }
  .form-lede { font-size: 14px; font-weight: 300; color: var(--gc-ink-muted); line-height: 1.7; max-width: 460px; margin: 12px auto 0; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .prt-success { text-align: center; background: var(--gc-sage-light); border: 1px solid #dde6e2; border-radius: 6px; padding: 40px 28px; }

  @media (max-width: 760px) {
    .partners-grid, .why-grid, .form-grid { grid-template-columns: 1fr; }
  }
</style>
