---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import WorthQuiz from '../components/WorthQuiz';
---

<Layout title="What Are You Worth?">
  <Nav variant="navy" minimalLabel="What Are You Worth? · A skills inventory" />
  <WorthQuiz client:load />
</Layout>

<style>
  :global(.quiz-intro) { background: var(--gc-navy); padding: 64px 32px 72px; text-align: center; position: relative; overflow: hidden; }
  :global(.quiz-glow) { position: absolute; top: -90px; right: -70px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, rgba(186, 217, 243, .22), transparent 70%); }
  :global(.quiz-intro-inner) { position: relative; z-index: 2; max-width: 640px; margin: 0 auto; }
  :global(.quiz-intro-copy) { font-size: 16px; font-weight: 300; color: rgba(255, 255, 255, .72); line-height: 1.8; max-width: 500px; margin: 20px auto 26px; }
  :global(.quiz-badges) { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 32px; }
  :global(.quiz-badge) { background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .16); border-radius: 100px; padding: 7px 16px; font-size: 12px; color: rgba(255, 255, 255, .72); }

  :global(.quiz-body) { max-width: 680px; margin: 0 auto; padding: 28px 24px 70px; }
  :global(.quiz-progress) { padding: 20px 0 14px; }
  :global(.quiz-progress-labels) { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font: 600 10px var(--font-sans); letter-spacing: .18em; text-transform: uppercase; color: var(--gc-ink-muted); }
  :global(.quiz-progress-track) { height: 4px; background: rgba(45, 52, 71, .12); border-radius: 2px; overflow: hidden; }
  :global(.quiz-progress-fill) { height: 100%; background: var(--gc-emerald); border-radius: 2px; transition: width .4s ease; }

  :global(.quiz-card) { background: #fff; border: 1px solid var(--gc-border); border-radius: 14px; box-shadow: 0 4px 24px rgba(53, 91, 116, .07); padding: 36px 32px; }
  :global(.quiz-q-badge) { display: inline-block; background: var(--gc-sage-light); border-radius: 6px; padding: 4px 11px; font: 600 10px var(--font-sans); letter-spacing: .08em; color: var(--gc-emerald); margin-bottom: 14px; white-space: nowrap; }
  :global(.quiz-q-context) { font-size: 13px; font-weight: 300; color: var(--gc-ink-muted); font-style: italic; line-height: 1.6; margin-bottom: 22px; }
  :global(.quiz-options) { display: flex; flex-direction: column; gap: 9px; }
  :global(.quiz-opt) { display: flex; align-items: flex-start; gap: 13px; padding: 14px 16px; border: 2px solid var(--gc-border); border-radius: 12px; background: #fff; cursor: pointer; transition: all .18s; user-select: none; }
  :global(.quiz-opt--sel) { border-color: var(--gc-emerald); background: var(--gc-sage-light); }
  :global(.quiz-opt-mark) { flex-shrink: 0; width: 24px; height: 24px; background: rgba(45, 52, 71, .08); color: var(--gc-ink-muted); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; margin-top: 1px; transition: all .18s; }
  :global(.quiz-opt-mark--sel) { background: var(--gc-emerald); color: #fff; }
  :global(.quiz-nav) { display: flex; gap: 10px; margin-top: 22px; }

  :global(.results-hero) { background: var(--gc-navy); border-radius: 16px; padding: 42px 32px; text-align: center; position: relative; overflow: hidden; }
  :global(.skill-bar) { margin-bottom: 14px; }
  :global(.skill-bar-labels) { display: flex; justify-content: space-between; margin-bottom: 6px; }
  :global(.skill-bar-track) { height: 8px; background: rgba(45, 52, 71, .08); border-radius: 4px; overflow: hidden; }
  :global(.skill-bar-fill) { height: 100%; border-radius: 4px; background: var(--gc-emerald); }

  :global(.stream-list) { display: flex; flex-direction: column; gap: 12px; }
  :global(.stream-card) { background: #fff; border: 1px solid var(--gc-border); border-radius: 12px; border-left: 4px solid var(--gc-emerald); padding: 20px 22px; }
  :global(.stream-range) { display: inline-block; background: var(--gc-cream); border-radius: 6px; padding: 4px 11px; font-size: 12px; font-weight: 600; color: var(--gc-slate); }

  :global(.imposter-note) { background: var(--gc-sage-light); border-radius: 12px; padding: 20px 22px; margin-top: 20px; font-size: 13px; color: var(--gc-ink); line-height: 1.65; border-left: 3px solid var(--gc-emerald); }
  :global(.reframe-box) { background: var(--gc-slate); border-radius: 14px; padding: 26px 28px; margin-top: 16px; }
  :global(.quiz-cta) { background: #fff; border: 1px solid var(--gc-border); border-radius: 14px; padding: 28px; text-align: center; margin-top: 16px; }
  :global(.quiz-cta-actions) { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
</style>
